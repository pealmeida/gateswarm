# __pycache__
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Large datasets — regenerate with generators
llmfit/datasets/*.jsonl
llmfit/datasets/general-purpose/*.jsonl
datasets/*.jsonl

# Results JSON (keep small summaries, not full outputs)
llmfit/datasets/v31_results_*.json
llmfit/datasets/v31_all_results.json

# Secrets / env
.env
.env.*.local
*.key
*.pem

# IDE
.vscode/
.idea/

# Local agent / tooling state
.claude/
.cursor/
CLAUDE.md

# Internal audit/working notes (not for public OSS distribution)
docs/FEATURE_AUDIT.md
docs/FIXES_AND_IMPROVEMENTS.md

# OS
.DS_Store
Thumbs.db

# pip temp dirs (from train.py ensure_deps())
pip-metadata-*/
pip-unpack-*/
pip-build-tracker-*/
pip-ephem-wheel-cache-*/
pip-install-*/

# Flash debug
.flash/

# Node dependencies
node_modules/

# Runtime logs
tee/
logs/
*.log
npm-debug.log*
.pytest_cache/
.coverage
htmlcov/

# Backup files
*.bak

# Sensitive agent registry (tokens — DO NOT COMMIT)
data/agent-registry.json

# Runtime data (regenerated at runtime — DO NOT COMMIT)
data/feedback/
data/rag/
data/benchmark-logs/
data/training/
data/token-economy.json

# Ephemeral runtime state (regenerated by the gateway on first run)
data/consumption-history.json
data/provider-quota.json
data/quota-sync.json
data/model-matrix.json

# Build artifacts
dist/

# Tee output (used by RTK output filter, v0.6.x backport)
tee/

# Hybrid / calibration eval reports (regenerated)
eval/reports/

# Git worktrees
.worktrees/
data/organic/
v05_ordinal_weights.json

# SSL experiment artifacts (regenerated) + downloaded corpora
eval/ssl/out/
eval/ssl/data/

# Never allow compiled shadows next to package sources (breaks resolution)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
