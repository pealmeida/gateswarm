# GateSwarm MoMA Router - Environment Variables
# Copy this file to .env and fill in your API keys.
# .env is gitignored; never commit real keys.

# Alibaba Bailian (Coding Plan) — optional
BAILIAN_KEY=sk-sp-xxxxx
BAILIAN_BASE=https://coding-intl.dashscope.aliyuncs.com/v1

# Z.AI (GLM Coding Lite) — required primary
GLM_API_KEY=your-api-key-here
ZAI_KEY=your-api-key-here
ZAI_BASE=https://api.z.ai/api/coding/paas/v4

# OpenCode Go (multi-model) — optional, used for free-tier fallbacks
OPENCODEGO_BASE=https://opencode.ai/zen/go/v1
OPENCODEGO_KEY=your-opencodego-key

# Ollama Cloud (free tier) — optional
OLLAMA_CLOUD_BASE=https://ollama.com/v1
OLLAMA_CLOUD_KEY=your-ollama-cloud-key

# Ollama (local CPU) — optional, defaults to localhost:11434
OLLAMA_BASE=http://127.0.0.1:11434/v1
OLLAMA_KEY=ollama

# Gateway
PORT=8900

# Auto-detected: the gateway uses this to locate scripts/cli-health-probe.sh
# In systemd it's set in the service unit; for local dev, set it to your repo root.
# GATESWARM_ROOT=/path/to/gateswarm-moma-router
