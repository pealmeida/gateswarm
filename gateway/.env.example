# GateSwarm MoMA Router - Environment Variables (legacy gateway/ subdir copy)
# New installs: copy ../.env.example to ../.env instead.
# This file is kept for backward compatibility with older systemd units.

# Alibaba Bailian (Coding Plan) — optional
BAILIAN_KEY=sk-sp-xxxxx
BAILIAN_BASE=https://coding-intl.dashscope.aliyuncs.com/v1

# Z.AI (GLM Coding Lite) — required primary
GLM_API_KEY=your-api-key-here
ZAI_BASE=https://api.z.ai/api/coding/paas/v4

# Gateway
PORT=8900
