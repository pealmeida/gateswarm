  "provider_rules": {
    "bailian_pace": {
      "description": "Bailian monthly credit pace >=120% of the linear cycle pace (needs GATESWARM_BAILIAN_CYCLE_START_DAY and a monthly usage % from quota-sync). Sheds Bailian from moderate+ tiers.",
      "condition": {
        "provider": "bailian",
        "window": "monthly",
        "pace_ratio_threshold": 1.2
      },
      "actions": [
        {
          "tier": "moderate",
          "remove": [
            {
              "provider": "bailian"
            }
          ]
