  "provider_rules": {
    "go_high": {
      "description": "OpenCode Go quota >70% in 5h window",
      "condition": {
        "provider": "opencodego",
        "window": "fiveHour",
        "threshold": 70
      },
      "actions": [
        {
          "tier": "moderate",
          "remove": [
            {
              "provider": "opencodego"
            }
          ]
        },
        {
          "tier": "heavy",
          "remove": [
            {
              "provider": "opencodego"
            }
          ]
        },
        {
          "tier": "intensive",
          "remove": [
            {
              "provider": "opencodego"
            }
          ]
        },
        {
          "tier": "extreme",
          "remove": [
            {
              "provider": "opencodego"
            }
          ]
        }
      ]
    },
    "zai_high": {
      "description": "ZAI quota >70% in 5h window",
      "condition": {
        "provider": "zai",
        "window": "fiveHour",
        "threshold": 70
      },
      "actions": [
        {
          "tier": "moderate",
          "demote_primary": true,
          "promote": {
            "provider": "ollama-cloud",
            "model": "minimax-m2.7"
          }
        },
        {
          "tier": "heavy",
          "demote_primary": true,
          "promote": {
            "provider": "ollama-cloud",
            "model": "deepseek-v4-pro"
          }
        },
        {
          "tier": "intensive",
          "remove": [
            {
              "provider": "zai"
            }
          ]
        },
        {
          "tier": "extreme",
          "remove": [
            {
              "provider": "zai"
            }
          ]
        }
      ]
    },
    "claude_high": {
      "description": "Claude CLI quota >70% in 5h window",
      "condition": {
        "provider": "claude-cli",
        "window": "fiveHour",
        "threshold": 70
      },
      "actions": [
        {
          "tier": "heavy",
          "remove": [
            {
              "provider": "claude-cli"
            }
          ]
        },
        {
          "tier": "intensive",
          "demote_primary": true,
          "promote": {
            "provider": "codex-cli",
            "model": "cx/gpt-6-sol"
          }
        },
        {
          "tier": "extreme",
          "demote_primary": true,
          "promote": {
            "provider": "codex-cli",
            "model": "cx/gpt-6-sol"
          }
        }
      ]
    },
    "codex_high": {
      "description": "Codex CLI quota >70% in 5h window",
      "condition": {
        "provider": "codex-cli",
        "window": "fiveHour",
        "threshold": 70
      },
      "actions": [
        {
          "tier": "intensive",
          "demote_primary": true,
          "promote": {
            "provider": "ollama-cloud",
            "model": "deepseek-v4-pro"
          }
        },
        {
          "tier": "extreme",
          "demote_primary": true,
          "promote": {
            "provider": "ollama-cloud",
            "model": "deepseek-v4-pro"
          }
        }
      ]
    },
    "both_http_high": {
      "description": "Both opencodego AND zai >70% in 5h window",
      "condition": {
        "providers": [
          "opencodego",
          "zai"
        ],
        "window": "fiveHour",
        "threshold": 70,
        "logic": "AND"
      },
      "actions": [
        {
          "tier": "trivial",
          "promote": {
            "provider": "ollama-cloud",
            "model": "minimax-m2.7"
          }
        },
        {
          "tier": "light",
          "promote": {
            "provider": "ollama-cloud",
